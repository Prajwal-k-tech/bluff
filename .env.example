# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Neon Postgres: console.neon.tech → project → Dashboard → Connection Details
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Frontend: FastAPI backend base URL (used by game page)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk auth (REQUIRED for /game — without a publishable key the game page
# hangs on "Loading…" with no error (useUser() never resolves; verified by
# browser test, AGENT_CHAT 2026-09-10). Get keys: dashboard.clerk.com → app.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
